[package]
name = "agentsniff-ebpf"
version = "2.0.2"
edition = "2021"
license = "Apache-2.0"
publish = false

# Stand-alone workspace so this kernel-space crate builds with its own
# nightly toolchain (separate from the userspace agentsniff workspace).
[workspace]

[dependencies]
aya-ebpf = "0.1"
aya-log-ebpf = "0.1"
agentsniff-common = { path = "../../agentsniff-common", version = "2.0.2", default-features = false }

[[bin]]
name = "dns"
path = "src/dns.rs"

[[bin]]
name = "connect"
path = "src/connect.rs"

[[bin]]
name = "tls"
path = "src/tls.rs"

[[bin]]
name = "traffic"
path = "src/traffic.rs"
